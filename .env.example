# ===== Used by docker-compose.yml (VPS deployment) =====
DOMAIN=worldvista.example.com
POSTGRES_PASSWORD=change-me-long-random

# ----- Required -----
JWT_SECRET=                      # openssl rand -hex 32
SEED_ADMIN_EMAIL=admin@yourdomain.com
SEED_ADMIN_PASSWORD=             # strong password, change after first login

# ----- Email (required in production) -----
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=World Vista <no-reply@yourdomain.com>

# ----- Optional integrations (each turns on when filled) -----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=            # e.g. +14155238886
SENTRY_DSN=
