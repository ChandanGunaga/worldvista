DATABASE_URL="postgresql://USER@localhost:5432/worldvista?schema=public"
JWT_SECRET="replace-with-64-hex-chars"      # openssl rand -hex 32
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
# Reverse proxies in front of the API: 1 locally / single proxy, 2 for Vercel -> Railway
TRUST_PROXY=1

# Email: leave SMTP_HOST empty in dev (emails print to the console). Required in production.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="World Vista <no-reply@worldvista.example>"

# Initial super admin created by the seed script
SEED_ADMIN_EMAIL="admin@worldvista.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Optional integrations — each switches on automatically when its values are set
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
SENTRY_DSN=""
UPLOAD_DIR="uploads"
